{
  "manifest_version": 3,
  "name": "WebLLM Doc Chat",
  "version": "0.1.0",
  "description": "Chat with your local documents using AI - Privacy-first, runs entirely on your device",
  
  "permissions": [
    "storage",
    "offscreen",
    "sidePanel"
  ],
  
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  
  "action": {
    "default_title": "Open Document Chat Sidepanel",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
